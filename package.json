{
  "name": "docs-trials",
  "version": "0.1.0",
  "description": "Check whether an AI coding agent can build a working integration from your developer documentation.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "docs-trials": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/cli.js.map",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbdulsaboorS/docs-trials.git"
  },
  "homepage": "https://github.com/AbdulsaboorS/docs-trials#readme",
  "bugs": {
    "url": "https://github.com/AbdulsaboorS/docs-trials/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "keywords": [
    "documentation",
    "developer-experience",
    "ai-agents",
    "testing",
    "devrel"
  ],
  "scripts": {
    "build": "node build.mjs",
    "dev": "tsx src/cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && oxlint .",
    "package:check": "node scripts/check-package.mjs",
    "prepack": "pnpm build",
    "prepublishOnly": "node scripts/publish-package.mjs --reject-direct",
    "release:pack": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm package:check",
    "release:publish": "node scripts/publish-package.mjs",
    "release:publish:dry-run": "node scripts/publish-package.mjs --dry-run",
    "test": "vitest run",
    "test:frameworks": "pnpm build && node scripts/run-framework-trials.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "js-tokens": "^10.0.0",
    "playwright": "^1.61.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@oxlint/plugins": "1.79.0",
    "@types/node": "^22.20.1",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "oxlint": "1.79.0",
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vitest": "^4.0.16"
  }
}
