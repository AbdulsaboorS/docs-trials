{
  "name": "docs-trials",
  "version": "0.1.0",
  "description": "Check whether an AI coding agent can build a working integration from your developer documentation.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "docs-trials": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbdulsaboorS/docs-trials.git"
  },
  "keywords": [
    "documentation",
    "developer-experience",
    "ai-agents",
    "testing",
    "devrel"
  ],
  "scripts": {
    "build": "node build.mjs",
    "dev": "tsx src/cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && oxlint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm lint && pnpm test && pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "playwright": "^1.61.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@oxlint/plugins": "1.79.0",
    "@types/node": "^24.10.1",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "oxlint": "1.79.0",
    "prettier": "^3.7.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vitest": "^4.0.16"
  }
}
